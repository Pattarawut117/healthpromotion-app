generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model activities {
  id                       BigInt                     @id @default(autoincrement())
  activity_name            String                     @db.VarChar(100)
  activity_type            String?                    @db.VarChar(50)
  title                    String?                    @db.VarChar(255)
  description              String?
  start_date               DateTime?                  @db.Date
  end_date                 DateTime?                  @db.Date
  is_active                Boolean?                   @default(true)
  play_mode                String?                    @db.VarChar(50)
  target_value             Int?
  created_at               DateTime?                  @default(now()) @db.Timestamptz(6)
  activities_user_register activities_user_register[]
}

model activities_user_register {
  id            BigInt      @id @default(autoincrement())
  user_id       String?     @db.VarChar(255)
  campaign_id   BigInt?
  activity_name String?     @db.VarChar(100)
  activity_type String?     @db.VarChar(50)
  is_active     Boolean?    @default(true)
  created_at    DateTime?   @default(now()) @db.Timestamptz(6)
  activities    activities? @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  user_info     user_info?  @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model user_info {
  user_id                  String                     @id @db.VarChar(255)
  sname                    String?                    @db.VarChar(255)
  lname                    String?                    @db.VarChar(255)
  tel                      String?
  dob                      DateTime?                  @db.Date
  height                   Int?
  weight                   Int?
  bmi                      Float?
  condential_disease       String[]
  sleep_per_hour           String?                    @db.VarChar(255)
  is_smoking               String?                    @db.VarChar(255)
  drink_beer               String?                    @db.VarChar(255)
  drink_water              String?                    @db.VarChar(255)
  sleep_problem            String?                    @db.VarChar(255)
  adhd                     String?                    @db.VarChar(255)
  madness                  String?                    @db.VarChar(255)
  bored                    String?                    @db.VarChar(255)
  introvert                String?                    @db.VarChar(255)
  unit                     String?                    @db.VarChar(255)
  eat_vegetable            String?                    @db.VarChar(255)
  eat_sour                 String?                    @db.VarChar(255)
  eat_sweetness            String?                    @db.VarChar(255)
  activities_tried         String?                    @db.VarChar(255)
  working_longtime         String?                    @db.VarChar(255)
  created_at               DateTime?                  @default(now()) @db.Timestamptz(6)
  waist                    Float?                     @db.Real
  body_fat_percentage      Int?                       @db.SmallInt
  division                 String?                    @db.VarChar
  gender                   String?                    @db.VarChar(50)
  sleep_enough             String?                    @db.VarChar(50)
  activities_user_register activities_user_register[]
}
